# File Downloader Service - Environment Configuration
# Copy this file to .env and adjust values as needed

# ===========================================
# Required Configuration
# ===========================================

# API key for authentication (REQUIRED for production)
# Generate a secure random string, e.g.: openssl rand -hex 32
API_KEY=your_secure_api_key_here

# ===========================================
# Optional - Server Configuration
# ===========================================

# Server port (default: 8000)
PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# ===========================================
# Optional - Rate Limiting
# ===========================================

# Maximum requests per time window per IP (default: 10)
RATE_LIMIT_REQUESTS=10

# Time window in seconds (default: 60)
RATE_LIMIT_WINDOW_SECONDS=60

# ===========================================
# Optional - Download Settings
# ===========================================

# Maximum concurrent downloads (default: 1)
MAX_CONCURRENT_DOWNLOADS=1

# Maximum download bandwidth in Mbps (default: 0 = unlimited)
MAX_BANDWIDTH_MBPS=100

# Automatically decompress .gz and .zip files (default: true)
AUTO_DECOMPRESS=true

# ===========================================
# Optional - Retry Settings
# ===========================================

# Maximum retry attempts for failed downloads (default: 3)
MAX_RETRY_ATTEMPTS=3

# Base backoff time in seconds for retries (default: 5)
# Actual backoff: 5s, 15s, 45s (exponential)
RETRY_BACKOFF_BASE_SECONDS=5

# ===========================================
# Optional - Webhook Settings
# ===========================================

# Maximum retry attempts for webhook delivery (default: 3)
WEBHOOK_RETRY_ATTEMPTS=3

# Base backoff time in seconds for webhook retries (default: 5)
WEBHOOK_RETRY_BACKOFF_SECONDS=5

# ===========================================
# Optional - Database & Storage
# ===========================================

# Path to SQLite database file (default: /data/downloads.db)
DATABASE_PATH=/data/downloads.db

# Number of days to retain download history (default: 30)
HISTORY_RETENTION_DAYS=30

# ===========================================
# Optional - Timezone
# ===========================================

# Timezone for logging and timestamps (default: UTC)
TZ=Europe/Prague
